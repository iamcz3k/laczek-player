<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LACZEK PLAYER"
            android:textColor="#FF8A3D"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LaCzek Player"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Offline music"
            android:textColor="#B7BAC4"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:backgroundTint="#FF8A3D"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="▶"
        android:textColor="#111111"
        android:textSize="18sp" />

    <Button
        android:id="@+id/widget_favorite"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:backgroundTint="#343640"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="♡"
        android:textColor="#FF8A3D"
        android:textSize="20sp" />

    <Button
        android:id="@+id/widget_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:backgroundTint="#343640"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="⏭"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</LinearLayout>
